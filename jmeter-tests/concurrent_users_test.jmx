                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;name&quot;: &quot;Test LabWork ${__threadNum} ${__time(YMDHMS)}&quot;,&#xd;
  &quot;coordinates&quot;: {&#xd;
    &quot;x&quot;: 10,&#xd;
    &quot;y&quot;: 20&#xd;
  },&#xd;
  &quot;description&quot;: &quot;Test description for concurrent testing&quot;,&#xd;
